# Nusxa oling: cp .env.example .env  — keyin qiymatlarni to'ldiring.
# .env fayli git'ga tushmaydi va Docker image ichiga kirmaydi.

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Arizalar tushadigan guruh yoki kanal, masalan -1001234567890 yoki @kanal_nomi
TELEGRAM_CHAT_ID=

# Telegram tugmalari va /hisobot buyrug'i uchun. Istalgan uzun tasodifiy matn (lotin harf va raqam), masalan:
#   openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Botga shaxsiy yozib /hisobot olish: arizalar guruhining a'zolari buni o'zi qila oladi.
# A'zo bo'la turib "Ruxsat yo'q" chiqsa (bot guruhda administrator bo'lmasa shunday bo'lishi mumkin),
# odamning Telegram ID raqamini shu yerga qo'shing, vergul bilan. Bot unga ID ni o'zi ko'rsatadi.
TELEGRAM_ADMIN_IDS=
# Ixtiyoriy: arizalar guruhidan tashqari yana qaysi guruhlarda /hisobot ishlasin (guruh ID, vergul bilan).
# Botni begona guruhga qo'shsa, u yerda hisobot BERILMAYDI: bot guruh ID ni yozadi, shuni bu yerga qo'shasiz.
TELEGRAM_ALLOWED_CHATS=

# Saytning to'liq manzili, oxirida "/" siz. Qidiruv tizimlari (SEO) uchun kerak.
SITE_URL=https://sizning-domen.uz

# Serverdagi port. 3800 boshqa loyihalar bilan to'qnashmaydi.
HOST_PORT=3800
# 127.0.0.1 — faqat nginx orqali ochiladi. To'g'ridan-to'g'ri IP:port orqali ochish uchun 0.0.0.0
BIND_ADDRESS=127.0.0.1

# Gemini chat API (server-side only; never expose this key in browser code)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
